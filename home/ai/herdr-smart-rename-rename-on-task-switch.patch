+  );
+  markModelAttempt(state, "t1", 1_000_000);
+  markModelSuccess(state, "t1", first, "s1");
+
+  const next = {
+    project: "P",
+    userRequests: ["fix login bug", "write the archive script"],
+  };
+
+  assert.equal(
+    shouldCallModel(state, "t1", next, 1_000_000 + TASK_MODEL_RATE_MS, "s1")
+      .allowed,
+    true,
+  );
+
+  // Raw process output still waits out the full rate limit.
+  const process = {
+    project: "P",
+    focusedPane: { process: "cargo test", recentOutput: "ok" },
