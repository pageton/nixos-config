# ─── Ephemeral server inventory — TEMPLATE ────────────────────────
# This .example file is COMMITTED to Git as documentation.
# Real IPs live in servers.nix (gitignored).
#
# SETUP: same as permanent — cp, edit, git add -f.
#
# Ephemeral servers are frequently created and destroyed.
# Keep this list short — remove entries when servers are decommissioned.
# ──────────────────────────────────────────────────────────────────
[
  {
    hostname = "ci-runner-01";
    ip = "10.42.0.10"; # Real IP — only in gitignored servers.nix
    user = "root";
    stateVersion = "26.05";
    roles = [ "ci-runner" ];
    tags = {
      env = "ci";
      ephemeral = "true";
      ttlHours = "6";
    };
  }
  {
    hostname = "build-agent-01";
    ip = "10.42.0.11";
    user = "root";
    stateVersion = "26.05";
    roles = [ "build-agent" ];
    tags = {
      env = "ci";
      ephemeral = "true";
      ttlHours = "4";
    };
  }
]
